{
  "name": "eligius",
  "author": "Roland Zwaga <rbzwaga@gmail.com>",
  "version": "3.0.1",
  "license": "MIT",
  "homepage": "https://rolandzwaga.github.io/eligius/",
  "bugs": {
    "url": "https://github.com/rolandzwaga/eligius/issues?q=is%3Aissue+is%3Aopen+label%3ABug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolandzwaga/eligius.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./metadata": {
      "types": "./dist/metadata.d.mts",
      "default": "./dist/metadata.mjs"
    },
    "./configuration-api": {
      "types": "./dist/configuration-api.d.mts",
      "default": "./dist/configuration-api.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "metadata": [
        "dist/metadata.d.mts"
      ],
      "configuration-api": [
        "dist/configuration-api.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "jsonschema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --pretty --noEmit",
    "test": "vitest --config src/vitest.config.ts",
    "test:ci": "vitest run --config src/vitest.config.ts --reporter=verbose",
    "test:coverage": "vitest --config src/vitest.config.ts --coverage",
    "generate-readmes": "tsx ./src/tools/doc-tools/generate-readmes",
    "generate-schema": "tsx ./src/tools/schema-tools/generate-schemas",
    "typedoc": "typedoc --options typedoc-metadata.json && typedoc --options typedoc.json",
    "docs": "npm run generate-schema && npm run typedoc && node copy-schema && npm run generate-readmes",
    "opers-metadata": "tsx src/tools/code-generator/metadata-generator.ts",
    "ctrls-metadata": "tsx src/tools/code-generator/ctrls-metadata-generator.ts",
    "events-metadata": "tsx src/tools/code-generator/events-metadata-generator.ts",
    "metadata": "npm run opers-metadata && npm run ctrls-metadata && npm run events-metadata",
    "ts-types": " tsc --noEmit false --emitDeclarationOnly --outDir dist",
    "build": "rimraf dist && npm run metadata && npm run generate-schema && tsdown",
    "check:types": "tsx src/tools/type-tools/check-dist-types.ts",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@rollup/plugin-alias": "6.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/jquery": "4.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "ajv": "8.20.0",
    "fs-extra": "11.4.1",
    "jquery": "4.0.0",
    "jsdom": "30.1.3",
    "lottie-web": "5.13.0",
    "rimraf": "6.1.3",
    "ts-json-schema-generator": "2.9.0",
    "ts-morph": "28.0.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typegraph-mcp": "^0.9.56",
    "video.js": "8.24.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@types/jquery": "^4.0.1",
    "jquery": "4.0.0",
    "lottie-web": "5.13.0",
    "video.js": "8.24.2"
  },
  "peerDependenciesMeta": {
    "@types/jquery": {
      "optional": true
    },
    "lottie-web": {
      "optional": true
    },
    "video.js": {
      "optional": true
    }
  },
  "dependencies": {
    "hotkeys-js": "4.0.8",
    "rosetta": "1.1.0",
    "ts-is-present": "1.2.2",
    "uuid": "14.0.3"
  },
  "types": "./dist/index.d.mts"
}
