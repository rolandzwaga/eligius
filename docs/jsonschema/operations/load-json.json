{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/load-json.json",
  "type": "object",
  "title": "loadJson Operation",
  "description": "Schema for the loadJson operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "loadJson",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL where the JSON will be retrieved from"
        },
        "cache": {
          "type": "boolean",
          "description": "If true, the results will be added to the cache and any subsequent call will use this cache"
        },
        "json": {
          "description": "The JSON retrieved from the given URL"
        }
      },
      "additionalProperties": true,
      "required": [
        "url"
      ]
    }
  },
  "additionalProperties": false
}