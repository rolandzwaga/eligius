{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/set-variable.json",
  "type": "object",
  "title": "setVariable Operation",
  "description": "Schema for the setVariable operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "setVariable",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": true,
      "required": [
        "name",
        "value"
      ]
    }
  },
  "additionalProperties": false
}