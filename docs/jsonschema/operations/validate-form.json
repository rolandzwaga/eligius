{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/validate-form.json",
  "type": "object",
  "title": "validateForm Operation",
  "description": "Schema for the validateForm operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "validateForm",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "validationRules": {
          "$ref": "#/definitions/Record%3Cstring%2CIValidationRules%3E"
        },
        "validationErrors": {
          "type": "object"
        },
        "isValid": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Record<string,IValidationRules>": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/IValidationRules"
      }
    },
    "IValidationRules": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "format": "regex"
            }
          ]
        },
        "email": {
          "type": "boolean"
        }
      }
    }
  }
}