{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/get-controller-instance.json",
  "type": "object",
  "title": "getControllerInstance Operation",
  "description": "Schema for the getControllerInstance operation (generated from IGetControllerInstanceOperationData)",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "getControllerInstance",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "systemName": {
          "type": "string",
          "description": "The name of a built-in controller, or of a controller registered on the\n`EligiusResourceImporter`."
        },
        "controllerInstance": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "systemName"
      ]
    }
  },
  "additionalProperties": false
}