{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/for-each.json",
  "type": "object",
  "title": "forEach Operation",
  "description": "Schema for the forEach operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "forEach",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "collection": {
          "anyOf": [
            {
              "type": "array",
              "items": {}
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "collection"
      ]
    }
  },
  "additionalProperties": false
}