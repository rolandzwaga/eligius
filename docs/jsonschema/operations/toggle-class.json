{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/toggle-class.json",
  "type": "object",
  "title": "toggleClass Operation",
  "description": "Schema for the toggleClass operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "toggleClass",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "className": {
          "type": "string",
          "description": "The class that will be toggled"
        }
      },
      "additionalProperties": true,
      "required": [
        "className"
      ]
    }
  },
  "additionalProperties": false
}