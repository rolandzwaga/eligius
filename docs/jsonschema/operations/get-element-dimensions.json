{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/get-element-dimensions.json",
  "type": "object",
  "title": "getElementDimensions Operation",
  "description": "Schema for the getElementDimensions operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "getElementDimensions",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "modifier": {
          "type": "object"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}