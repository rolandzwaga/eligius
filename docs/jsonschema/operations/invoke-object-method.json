{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/invoke-object-method.json",
  "type": "object",
  "title": "invokeObjectMethod Operation",
  "description": "Schema for the invokeObjectMethod operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "invokeObjectMethod",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "methodName": {
          "type": "string",
          "description": "The method name on the given object that will be invoked"
        },
        "methodArguments": {
          "type": "array",
          "items": {},
          "description": "Arguments that will be passed to the specified method"
        },
        "methodResult": {
          "description": "If any, the results of the method invocation are assigned to the property"
        }
      },
      "additionalProperties": true,
      "required": [
        "methodName"
      ]
    }
  },
  "additionalProperties": false
}