{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/calc.json",
  "type": "object",
  "title": "calc Operation",
  "description": "Schema for the calc operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "calc",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "left": {
          "type": "number",
          "description": "The left operand"
        },
        "right": {
          "type": "number",
          "description": "The right operand"
        },
        "operator": {
          "$ref": "#/definitions/TCalculationOperator"
        },
        "calculationResult": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "required": [
        "left",
        "right",
        "operator"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "TCalculationOperator": {
      "type": "string",
      "enum": [
        "+",
        "-",
        "*",
        "/",
        "%",
        "**"
      ]
    }
  }
}