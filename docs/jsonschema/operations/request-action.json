{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/request-action.json",
  "type": "object",
  "title": "requestAction Operation",
  "description": "Schema for the requestAction operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "requestAction",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "systemName": {
          "type": "string"
        },
        "actionInstance": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "systemName"
      ]
    }
  },
  "additionalProperties": false
}