{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/scroll-to-element.json",
  "type": "object",
  "title": "scrollToElement Operation",
  "description": "Schema for the scrollToElement operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "scrollToElement",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "behavior": {
          "$ref": "#/definitions/ScrollBehavior"
        },
        "block": {
          "$ref": "#/definitions/ScrollLogicalPosition"
        },
        "inline": {
          "$ref": "#/definitions/ScrollLogicalPosition"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ScrollBehavior": {
      "type": "string",
      "enum": [
        "auto",
        "smooth"
      ]
    },
    "ScrollLogicalPosition": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "nearest"
      ]
    }
  }
}