{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/add-globals-to-operation.json",
  "type": "object",
  "title": "addGlobalsToOperation Operation",
  "description": "Schema for the addGlobalsToOperation operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "addGlobalsToOperation",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "globalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The names of the global properties that will be copied onto the current operation data"
        }
      },
      "additionalProperties": true,
      "required": [
        "globalProperties"
      ]
    }
  },
  "additionalProperties": false
}