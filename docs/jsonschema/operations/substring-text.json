{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/substring-text.json",
  "type": "object",
  "title": "substringText Operation",
  "description": "Schema for the substringText operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "substringText",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "substring": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "start"
      ]
    }
  },
  "additionalProperties": false
}