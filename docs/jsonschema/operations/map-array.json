{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/map-array.json",
  "type": "object",
  "title": "mapArray Operation",
  "description": "Schema for the mapArray operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "mapArray",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "mapFunction": {
          "type": "object",
          "properties": {
            "namedArgs": {
              "type": "object",
              "properties": {
                "item": {},
                "index": {
                  "type": "number"
                }
              },
              "required": [
                "item"
              ],
              "additionalProperties": false
            }
          }
        },
        "mappedArray": {
          "type": "array",
          "items": {}
        }
      },
      "additionalProperties": true,
      "required": [
        "mapFunction"
      ]
    }
  },
  "additionalProperties": false
}