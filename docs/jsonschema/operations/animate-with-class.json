{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/animate-with-class.json",
  "type": "object",
  "title": "animateWithClass Operation",
  "description": "Schema for the animateWithClass operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "animateWithClass",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "className": {
          "type": "string"
        },
        "removeClass": {
          "type": "boolean",
          "description": "When true (the default), the class is removed again after the animation ends"
        },
        "includeDescendants": {
          "type": "boolean",
          "description": "When true, the operation resolves on the first `animationend` event from the selected element or any of its descendants. Use this for a class that only animates descendants. When false (the default), only animations on the selected elements themselves are awaited."
        }
      },
      "additionalProperties": true,
      "required": [
        "className"
      ]
    }
  },
  "additionalProperties": false
}