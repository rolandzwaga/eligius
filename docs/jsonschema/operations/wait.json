{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/wait.json",
  "type": "object",
  "title": "wait Operation",
  "description": "Schema for the wait operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "wait",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "milliseconds": {
          "type": "number",
          "description": "The amount of milliseconds the operation will wait for."
        }
      },
      "additionalProperties": true,
      "required": [
        "milliseconds"
      ]
    }
  },
  "additionalProperties": false
}