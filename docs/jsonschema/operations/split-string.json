{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/split-string.json",
  "type": "object",
  "title": "splitString Operation",
  "description": "Schema for the splitString operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "splitString",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "delimiter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "format": "regex"
            }
          ]
        },
        "limit": {
          "type": "number"
        },
        "resultArray": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "delimiter"
      ]
    }
  },
  "additionalProperties": false
}