{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/announce-to-screen-reader.json",
  "type": "object",
  "title": "announceToScreenReader Operation",
  "description": "Schema for the announceToScreenReader operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "announceToScreenReader",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "message": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "polite",
            "assertive"
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "message"
      ]
    }
  },
  "additionalProperties": false
}