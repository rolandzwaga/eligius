{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/replace-text.json",
  "type": "object",
  "title": "replaceText Operation",
  "description": "Schema for the replaceText operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "replaceText",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "searchPattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "format": "regex"
            }
          ]
        },
        "replacement": {
          "type": "string"
        },
        "replacementCount": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "required": [
        "searchPattern",
        "replacement"
      ]
    }
  },
  "additionalProperties": false
}