{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/find-in-array.json",
  "type": "object",
  "title": "findInArray Operation",
  "description": "Schema for the findInArray operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "findInArray",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "findProperty": {
          "type": "string"
        },
        "findValue": {},
        "findPredicate": {
          "type": "object",
          "properties": {
            "namedArgs": {
              "type": "object",
              "properties": {
                "item": {},
                "index": {
                  "type": "number"
                }
              },
              "required": [
                "item"
              ],
              "additionalProperties": false
            }
          }
        },
        "foundItem": {},
        "foundIndex": {
          "type": "number"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}