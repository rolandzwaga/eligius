{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/scroll-to-position.json",
  "type": "object",
  "title": "scrollToPosition Operation",
  "description": "Schema for the scrollToPosition operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "scrollToPosition",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "behavior": {
          "$ref": "#/definitions/ScrollBehavior"
        }
      },
      "additionalProperties": true,
      "required": [
        "x",
        "y"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ScrollBehavior": {
      "type": "string",
      "enum": [
        "auto",
        "smooth"
      ]
    }
  }
}