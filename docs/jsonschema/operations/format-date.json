{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/format-date.json",
  "type": "object",
  "title": "formatDate Operation",
  "description": "Schema for the formatDate operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "formatDate",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "format": {
          "type": "string"
        },
        "formattedDate": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "format"
      ]
    }
  },
  "additionalProperties": false
}