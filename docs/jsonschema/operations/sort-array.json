{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/sort-array.json",
  "type": "object",
  "title": "sortArray Operation",
  "description": "Schema for the sortArray operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "sortArray",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "sortProperty": {
          "type": "string"
        },
        "sortOrder": {
          "$ref": "#/definitions/SortOrder"
        },
        "sortComparator": {
          "type": "object",
          "properties": {
            "namedArgs": {
              "type": "object",
              "properties": {
                "a": {},
                "b": {}
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            }
          }
        },
        "sortedArray": {
          "type": "array",
          "items": {}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SortOrder": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    }
  }
}