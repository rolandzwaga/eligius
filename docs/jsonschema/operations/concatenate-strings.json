{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/concatenate-strings.json",
  "type": "object",
  "title": "concatenateStrings Operation",
  "description": "Schema for the concatenateStrings operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "concatenateStrings",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "strings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "separator": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "strings"
      ]
    }
  },
  "additionalProperties": false
}