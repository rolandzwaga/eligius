{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/animate.json",
  "type": "object",
  "title": "animate Operation",
  "description": "Schema for the animate operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "animate",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "animationEasing": {
          "type": "string"
        },
        "animationProperties": {
          "$ref": "#/definitions/Record%3Cstring%2Cunknown%3E"
        },
        "animationDuration": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "required": [
        "animationProperties",
        "animationDuration"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Record<string,unknown>": {
      "type": "object",
      "additionalProperties": {}
    }
  }
}