{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/set-element-content.json",
  "type": "object",
  "title": "setElementContent Operation",
  "description": "Schema for the setElementContent operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "setElementContent",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "DOM element (JQuery.Node)"
            }
          ]
        },
        "insertionType": {
          "type": "string",
          "enum": [
            "overwrite",
            "append",
            "prepend"
          ],
          "description": "overwite = the contents of the selected element are replaced by the given template\n\nappend = the new content will be inserted after the current content\n\nprepend = the new content will be inserted before the current content\n\nDefaults to overwrite."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}