{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/reparent-element.json",
  "type": "object",
  "title": "reparentElement Operation",
  "description": "Schema for the reparentElement operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "reparentElement",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "newParentSelector": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "newParentSelector"
      ]
    }
  },
  "additionalProperties": false
}