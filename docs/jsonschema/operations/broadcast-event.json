    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "eventArgs": {
          "type": "array",
          "items": {}
        },
        "eventTopic": {
          "type": "string"
        },
        "eventName": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "eventArgs",
        "eventName"
      ]
    }
  },
  "additionalProperties": false
}