{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/math.json",
  "type": "object",
  "title": "math Operation",
  "description": "Schema for the math operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "math",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/MathNonFunctionKeys"
              }
            ]
          }
        },
        "functionName": {
          "type": "string"
        },
        "mathResult": {
          "type": "number"
        }
      },
      "additionalProperties": true,
      "required": [
        "args",
        "functionName"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "MathNonFunctionKeys": {
      "type": "string",
      "enum": [
        "E",
        "LN10",
        "LN2",
        "LOG2E",
        "LOG10E",
        "PI",
        "SQRT1_2",
        "SQRT2"
      ]
    }
  }
}