{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/get-query-params.json",
  "type": "object",
  "title": "getQueryParams Operation",
  "description": "Schema for the getQueryParams operation",
  "required": [
    "id",
    "systemName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "getQueryParams",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "queryParams": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E",
          "description": "The query params will be added as property/values to this object. So, the query string `?foo=bar&bar=foo` will result in: ```json {    foo: \"bar\",    bar: \"foo\" } ``` This object will be assigned to the `queryParams` property."
        },
        "defaultValues": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E",
          "description": "The properties on this object will be assigned to the queryParams result when the given property name is not part of the query string."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Record<string,string>": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}