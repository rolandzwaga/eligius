{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/format-text.json",
  "type": "object",
  "title": "formatText Operation",
  "description": "Schema for the formatText operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "formatText",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "transformation": {
          "$ref": "#/definitions/TextTransformation"
        },
        "formattedText": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "transformation"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "TextTransformation": {
      "type": "string",
      "enum": [
        "uppercase",
        "lowercase",
        "capitalize",
        "titlecase",
        "trim"
      ]
    }
  }
}