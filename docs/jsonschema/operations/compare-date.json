{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/compare-date.json",
  "type": "object",
  "title": "compareDate Operation",
  "description": "Schema for the compareDate operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "compareDate",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "date1": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "date2": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "comparison": {
          "type": "number"
        },
        "isEqual": {
          "type": "boolean"
        },
        "isBefore": {
          "type": "boolean"
        },
        "isAfter": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "date1",
        "date2"
      ]
    }
  },
  "additionalProperties": false
}