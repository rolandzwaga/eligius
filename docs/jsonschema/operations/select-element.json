{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rolandzwaga.github.io/eligius/jsonschema/operations/select-element.json",
  "type": "object",
  "title": "selectElement Operation",
  "description": "Schema for the selectElement operation",
  "required": [
    "id",
    "systemName",
    "operationData"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the operation"
    },
    "systemName": {
      "const": "selectElement",
      "description": "The operation system name"
    },
    "operationData": {
      "type": "object",
      "description": "Operation-specific configuration data",
      "properties": {
        "selector": {
          "type": "string"
        },
        "useSelectedElementAsRoot": {
          "type": "boolean"
        },
        "selectedElement": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "selector"
      ]
    }
  },
  "additionalProperties": false
}